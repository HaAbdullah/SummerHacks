# Copy this file to .env:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)

# App
APP_NAME=SummerHacks API
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated frontend origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Supabase. Leave blank and the app uses a local JSON file (data/db.json) plus local
# disk for uploads - no setup needed. Fill both in and it switches to Postgres and
# Supabase Storage with no code change. GET /api/health reports which is live.
#
# Dashboard -> Project Settings -> Data API for the URL,
# Project Settings -> API Keys for the service_role key.
#
# The service_role key bypasses row-level security. Keep it server-side only - it must
# never appear in frontend code or in NEXT_PUBLIC_* vars.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=community-media

# Optional stopgap so db.json survives a restart before Supabase is set up (Render's
# free plan resets local disk on every sleep/wake). Free, no schema: a Redis db on
# console.upstash.com -> REST API tab for both values. Leave blank and nothing changes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LangChain comparison orchestrator. The model selects tools only; deterministic Python
# functions own comparison, mutation, catalogue arithmetic, and final validation.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
COMPARE_AGENT_RECURSION_LIMIT=20

# Gemini multimodal understanding and Nano Banana schematic generation.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
BLUEPRINT_AI_TIMEOUT_SECONDS=90
BLUEPRINT_GENERATION_ATTEMPTS=2
BLUEPRINT_COMPONENT_CONFIDENCE_THRESHOLD=0.80
BLUEPRINT_ENGINE_DETECTION_CONFIDENCE_THRESHOLD=0.70
BLUEPRINT_MAX_IMAGE_BYTES=15728640
BLUEPRINT_MAX_IMAGE_PIXELS=40000000
