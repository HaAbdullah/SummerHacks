# ============================================================
# SummerHacks — shared environment template
# ============================================================
# Easiest path: run the setup script from the repo root:
#   Windows:  .\scripts\setup-env.ps1
#   macOS/Linux:  ./scripts/setup-env.sh
#
# Or copy manually:
#   copy .env.example .env
#   copy backend\.env.example backend\.env
#   copy frontend\.env.example frontend\.env.local
#
# Never commit real .env files — only the *.example templates.
# ============================================================

# ---------- Backend (FastAPI) ----------
APP_NAME=SummerHacks API
APP_ENV=development
DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Gemini multimodal understanding for engine-image blueprint analysis.
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
BLUEPRINT_AI_TIMEOUT_SECONDS=90
BLUEPRINT_GENERATION_ATTEMPTS=2
BLUEPRINT_COMPONENT_CONFIDENCE_THRESHOLD=0.80
BLUEPRINT_ENGINE_DETECTION_CONFIDENCE_THRESHOLD=0.70

# ---------- Frontend (Next.js) ----------
# Next.js only exposes vars prefixed with NEXT_PUBLIC_ to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000
